{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "console_title_template": "{{if .Root}} \u26a1 {{end}}{{.Folder | replace \"~\" \"\ud83c\udfe0\"}} @ {{.HostName}}",
  "palettes": {
    "template": "monokai-pro",
    "list": {
      "monokai-pro": {
        "background": "#2D2A2E",
        "foreground": "#FCFCFA",
        "keyword": "#FF6188",
        "argument": "#FC9867",
        "string": "#FFD866",
        "function": "#A9DC76",
        "class": "#78DCE8",
        "constant": "#AB9DF2"
      }
    }
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:foreground",
          "template": "\u250f\u2501"
        },
        {
          "type": "os",
          "style": "diamond",
          "foreground": "p:background",
          "background": "p:foreground",
          "template": " {{ .Icon }} ",
          "leading_diamond": "\ue0b6"
        },
        {
          "type": "session",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:string",
          "template": " {{ if .SSHSession }} {{ .UserName }}@{{ .HostName }}{{ else }}\uf007 {{ .UserName }}{{ end }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "root",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:class",
          "template": " \uf0e7 ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:argument",
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_icon": "...",
            "folder_separator_icon": "<transparent> \ue0b1 </>",
            "home_icon": "\uf015",
            "max_depth": 1,
            "style": "agnoster_short"
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:function",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:keyword{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:constant{{ end }}",
            "{{ if gt .Ahead 0 }}p:function{{ end }}",
            "{{ if gt .Behind 0 }}p:argument{{ end }}"
          ],
          "template": " {{ if .UpstreamIcon }}{{ .UpstreamIcon }} {{ end }}{{ .HEAD }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\uf126 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          }
        },
        {
          "type": "cftarget",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:class",
          "template": " \uf135 {{ .Org }} / {{ .Space }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "display_mode": "files",
            "files": [
              "ui5.yaml",
              "webapp/manifest.json"
            ]
          },
          "cache": {
            "duration": "1h",
            "strategy": "session"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:keyword",
          "template": " \uf12a {{ reason .Code }} ",
          "powerline_symbol": "\ue0b0"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:class",
          "template": " {{ .FormattedMs }}s ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "dallas",
            "threshold": 0
          }
        },
        {
          "type": "time",
          "style": "powerline",
          "foreground": "p:background",
          "background": "p:constant",
          "template": " {{ .CurrentDate | date .Format }} ",
          "powerline_symbol": "\ue0b0",
          "options": {
            "time_format": "15:04"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:foreground",
          "template": "<p:foreground>\u2517\u2501</>{{ if .Root }}<p:keyword>#</>{{ else }}<p:foreground>$</>{{ end }} ",
          "powerline_symbol": "\ue0b0"
        }
      ]
    }
  ]
}
